<?xml version="1.0" encoding="utf-8"?>
<!--
  Release build for Windows x64 as one self-contained, compressed FmrFit.App.exe (no .NET install needed).
  dotnet publish src/FmrFit.App -p:PublishProfile=win-x64 -p:Version=0.1.6 -o <folder outside the repository>
  Run from a folder outside the repository, the app keeps Projects\ and fmr-fit.ini next to the exe.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native libraries (Skia, HarfBuzz, ANGLE) inside the exe too; extracted to a temp folder on first start. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
