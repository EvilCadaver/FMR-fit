<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FmrFit.App.ConfirmDialog"
        SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Title="FMR-fit">
    <StackPanel Margin="20" Spacing="20" MaxWidth="460">
        <TextBlock Name="MessageText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="ConfirmButton" Content="OK" Classes="accent" Click="ConfirmButton_Click" />
            <Button Name="CancelButton" Content="Cancel" IsCancel="True" Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
